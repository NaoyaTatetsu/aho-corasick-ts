{
  "name": "aho-corasick-ts",
  "version": "0.1.0",
  "description": "Fast, dependency-free Aho-Corasick matching with adaptive typed-array transitions",
  "author": "Naoya Tatetsu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NaoyaTatetsu/aho-corasick-ts.git"
  },
  "homepage": "https://github.com/NaoyaTatetsu/aho-corasick-ts#readme",
  "bugs": {
    "url": "https://github.com/NaoyaTatetsu/aho-corasick-ts/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.4.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "pnpm build && node --test test/*.test.mjs",
    "coverage": "pnpm build && node --test --experimental-test-coverage --test-coverage-exclude='test/**' test/*.test.mjs",
    "benchmark": "pnpm build && node benchmark/run.mjs",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@monyone/aho-corasick": "^1.0.0",
    "@stll/aho-corasick": "1.0.4",
    "ahocorasick": "1.0.2",
    "modern-ahocorasick": "2.0.4",
    "typescript": "7.0.2"
  },
  "keywords": [
    "aho-corasick",
    "string-search",
    "multi-pattern",
    "typescript"
  ]
}
