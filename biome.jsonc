{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "files": {
    // benchmark/baseline.* is a frozen snapshot of a past src/index.ts, kept byte-for-byte
    // so `pnpm benchmark --compare` measures the same code it always did. Marked "Do not edit".
    "includes": ["src/**/*.ts", "test/**/*.mjs", "benchmark/run.mjs", ".github/scripts/*.mjs", "example/*.ts"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    // Wide enough to keep the transition loops and the dense benchmark adapters on one line.
    "lineWidth": 200
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "arrowParentheses": "asNeeded",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        // tsconfig sets noUncheckedIndexedAccess, so every TypedArray read is T | undefined
        // and needs an assertion. The rule's own fix is `?.`, which would put a runtime check
        // in the per-character loops this library exists to keep tight.
        "noNonNullAssertion": "off"
      },
      "suspicious": {
        // MatchCallback returns `void | boolean`. Narrowing it to `undefined | boolean` as the
        // rule suggests rejects any handler declared with an explicit `void` return type,
        // which is a breaking change to the public API.
        "noConfusingVoidType": "off"
      }
    }
  },
  // benchmark/run.mjs groups its imports by role (node builtins, the local build, competitors).
  "assist": { "actions": { "source": { "organizeImports": "off" } } }
}
